# --- LLM (any OpenAI-compatible endpoint: OpenRouter, Groq, Together, vLLM, Ollama...) ---
LLM_API_KEY=your-key
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=liquid/lfm-2.5-1.2b-thinking:free
# Tried in order when LLM_MODEL errors out. Empty = free models from the provider catalog (openrouter/free on OpenRouter)
LLM_FALLBACK_MODELS=
# Optional text prepended to every system prompt
BASE_PROMPT=

# --- PostgreSQL ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=evalio
DB_USER=postgres
DB_PASSWORD=postgres

# --- Repository ingestion ---
# Needed only for private GitHub repositories (and to avoid clone rate limits)
GITHUB_TOKEN=
REPO_MAX_CHUNKS=1200

# --- Vector store (embedded by default; set CHROMA_HOST to share one server between workers) ---
CHROMA_DIR=./data/chroma
CHROMA_HOST=

# --- Embeddings (code index + semantic search) ---
# Use any OpenAI-compatible /embeddings endpoint instead of Chroma's in-process ONNX
# model: loading that model needs 600MB+ of RAM (more than a Render free instance) and
# can stall on its first download. Leave empty to keep the bundled local model.
# Free-tier options with an OpenAI-compatible /v1/embeddings route: NVIDIA NIM
# (nvidia/nemotron-3-embed-1b), Mistral AI (mistral-embed), Jina AI, Voyage AI.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# --- Evaluation worker ---
# Set RUN_WORKER=false on the API and run `python worker.py` separately to scale out
RUN_WORKER=true
WORKER_CONCURRENCY=2
# Hard per-stage budget (seconds): a stuck clone/embedder/LLM call is abandoned
# instead of wedging a worker and stalling the whole queue
STAGE_TIMEOUT=900
# Hard budget for indexing the source into Chroma (best effort)
REPO_INDEX_TIMEOUT=240

# --- Showcase ---
# Seeds an example hackathon with judged projects plus an open sandbox (set false to disable)
SEED_DEMO=true

# --- Showcase ---
# Seeds an example hackathon with judged projects plus an open sandbox (set false to disable)
SEED_DEMO=true

# --- HTTP ---
# Comma-separated; empty allows all origins
CORS_ORIGINS=https://evalio-frontend-gules.vercel.app
